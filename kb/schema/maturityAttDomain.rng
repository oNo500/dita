<?xml version="1.0" encoding="UTF-8"?>
<!-- KB 成熟度属性域：从 @props 专门化出 @maturity。
     受控值（draft/curated/verified）由 vocab/subjectScheme.ditamap 绑定。
     照 OASIS platformAttDomain.rng 模式编写。 -->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
  xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
  xmlns:dita="http://dita.oasis-open.org/architecture/2005/"
  datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <moduleDesc xmlns="http://dita.oasis-open.org/architecture/2005/">
    <moduleTitle>KB Maturity Attribute Domain</moduleTitle>
    <moduleMetadata>
      <moduleType>attributedomain</moduleType>
      <moduleShortName>maturityAtt-d</moduleShortName>
      <modulePublicIds>
        <rngMod>urn:x-kb:names:rng:maturityAttDomain.rng</rngMod>
      </modulePublicIds>
      <domainsContribution>@props/maturity</domainsContribution>
    </moduleMetadata>
  </moduleDesc>

  <define name="maturityAtt-d-attribute">
    <optional>
      <attribute name="maturity" dita:since="2.0">
        <a:documentation>内容成熟度：draft / curated / verified（受控值见 subjectScheme）。</a:documentation>
      </attribute>
    </optional>
  </define>

  <define name="props-attribute-extensions" combine="interleave">
    <ref name="maturityAtt-d-attribute"/>
  </define>
</grammar>
