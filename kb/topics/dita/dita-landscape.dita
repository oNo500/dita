<!-- 领域全景（tech-landscape 体裁）：dita 域。
     2026-08-19 重写：正文主体由本库自拟的维度框架改为业界生态与标准——这个领域有哪些
     规范、谁在维护、有哪些实现与工具、当前处在什么状态。维度框架退为末尾一节的机读清单
     索引，规划清单本身仍在 prolog，覆盖度与盲区由 dita-tools ia 求差算出，正文零手抄。
     体裁后缀同日改回「领域全景」（词表 genre-values 与 naming-rules 为正本）。
     原正文的六组维度表与分组论证已删；「版本现状」与「与其他方案的定位差」两节吸收进
     当前状态与定位差两节。三路对标（OASIS 规范编排 ＋ DITA-OT 文档类目 ＋ 调研笔记问题分布）
     的登记在词表 benchmark-registry 的 bm-dita，本篇不复述。

     本库自造：全景篇在上游无对应节点。三道关如下。一、穷尽查证。上游节点索引
     （kb/vocab/upstream-nodes.tsv，OASIS 2.0 规范 archSpec/langRef ＋ DITA-OT 4.4 docsrc）
     内无「领域全景」这一体裁的节点——两边都不给某个技术领域的全景篇，只给机制节点与工具操作。
     二、先怀疑切分。全景篇的边界就是整个分支，无处可并；重切等于取消这一体裁。
     三、只组合，不发明。「领域全景」是本库 tech-landscape 体裁的固定后缀，DITA 为领域名。 -->
<concept id="dita-landscape" xml:lang="zh-CN"
         outputclass="tech-landscape"
         maturity="draft" volatility="volatile"
         dimension="dim-comparison dim-evolution dim-ecosystem">
  <title>DITA 领域全景</title>
  <shortdesc>DITA 由 OASIS 的 DITA 技术委员会维护，1.3 是现行正式版，2.0 停在 beta；工具链一侧以 DITA-OT 为参考实现，按自己的节奏对 2.0 做预览支持。结构化内容这一片还有交换与交付两侧的相邻标准各管一段，选型与落地的判断从这几处的实况出发。</shortdesc>
  <prolog>
    <source href="https://dita-lang.org/specifications" scope="external"/>
    <data name="domain" value="dita"/>
    <data name="upstream-node" value="coined"/>
    <data name="reviewed" value="2026-08-19"/>
    <!-- 本域规划维度清单（机读）。内容 topic 在根元素标 @dimension 声明覆盖，
         构建期按 domain 分组求差得盲区与覆盖度。 -->
    <data name="planned-dimension" value="dim-principles"/>
    <data name="planned-dimension" value="dim-roles"/>
    <data name="planned-dimension" value="dim-concept"/>
    <data name="planned-dimension" value="dim-structure-template"/>
    <data name="planned-dimension" value="dim-classification"/>
    <data name="planned-dimension" value="dim-mechanism"/>
    <data name="planned-dimension" value="dim-relations"/>
    <data name="planned-dimension" value="dim-process"/>
    <data name="planned-dimension" value="dim-consistency"/>
    <data name="planned-dimension" value="dim-internals"/>
    <data name="planned-dimension" value="dim-integration"/>
    <data name="planned-dimension" value="dim-interop"/>
    <data name="planned-dimension" value="dim-retrieval"/>
    <data name="planned-dimension" value="dim-install"/>
    <data name="planned-dimension" value="dim-usage"/>
    <data name="planned-dimension" value="dim-troubleshooting"/>
    <data name="planned-dimension" value="dim-reference"/>
    <data name="planned-dimension" value="dim-ecosystem"/>
    <data name="planned-dimension" value="dim-comparison"/>
    <data name="planned-dimension" value="dim-decision"/>
