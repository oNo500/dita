  <topicref href="../topics/glossary/term-tool-search.dita" keys="term-tool-search"/>
  <topicref href="../topics/glossary/term-progressive-disclosure.dita" keys="term-progressive-disclosure"/>
  <!-- 2026-08-16 第三批：dita 域 core-model 簇引入的跨篇术语（两条各出现于本簇三篇，过第二篇门槛）-->
  <topicref href="../topics/glossary/term-conref.dita" keys="term-conref"/>
  <topicref href="../topics/glossary/term-keyref.dita" keys="term-keyref"/>
  <!-- 2026-08-16 第四批：dita 域 toolchain 簇引入的跨篇术语（三条各出现于本簇多篇，过第二篇门槛）-->
  <topicref href="../topics/glossary/term-transtype.dita" keys="term-transtype"/>
  <topicref href="../topics/glossary/term-preprocess.dita" keys="term-preprocess"/>
  <topicref href="../topics/glossary/term-plugin.dita" keys="term-plugin"/>
  <!-- 2026-08-16 第五批：dita 域 practice 簇引入的跨篇术语（DITAVAL 出现于六篇、RAG 出现于三篇，过第二篇门槛）-->
  <topicref href="../topics/glossary/term-ditaval.dita" keys="term-ditaval"/>
  <topicref href="../topics/glossary/term-rag.dita" keys="term-rag"/>
  <!-- 2026-08-16 第六批：并行各簇留下的跨篇候选，由 conditional 簇统一裁决建条
       （specialization 十余篇、document-type shell 与 schema 各四篇以上、generalization 四篇、
       constraint 三篇、subject scheme 四篇，均已过第二篇门槛）。正文 keyref 的跨簇回填另行统一进行。
       译名禁令：这几条在规范里都有对应条目，glossterm 一律英文原名，中文只进 glossdef。
       2026-08-17 更正：此前把「泛化」也列为本库自造译名，是错的——「泛化」是 generalization
       的领域标准译法，与 specialization 的「特化」成对；错的是「专门化」，它既无出处又译错。
       中文别名只登记领域标准译法（specialization→「特化」、generalization→「泛化」），
       供检索召回；不设「专门化」这类错译或自造译名作别名。 -->
  <topicref href="../topics/glossary/term-specialization.dita" keys="term-specialization"/>
  <topicref href="../topics/glossary/term-generalization.dita" keys="term-generalization"/>
  <topicref href="../topics/glossary/term-constraint.dita" keys="term-constraint"/>
  <topicref href="../topics/glossary/term-document-type-shell.dita" keys="term-document-type-shell"/>
  <topicref href="../topics/glossary/term-schema.dita" keys="term-schema"/>
  <topicref href="../topics/glossary/term-subject-scheme.dita" keys="term-subject-scheme"/>
</map>
