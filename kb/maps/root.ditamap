<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA 2.0 Map//EN" "map.dtd">
<!-- root map：全库总组织（信息架构师产出）。引所有领域 map + glossary map。
     这是键空间的根（见 dita2 笔记 10 寻址与键空间）。

     为什么每个 mapref 都包一层 topichead：
     规范规定 mapref 的处理是"被引 map 的层级并入容器 map"，被引 map 的 <title>
     不产生导航节点。实测（2026-08-15，dita -f html5）：不包 wrapper 的领域，其
     topic 被直接摊到 TOC 顶层，分支名在产物里根本不存在。wrapper 是补这个缺口的，
     不是 DITA 2.0 的语法要求。

     代价是分支名在此与领域 map 的 <title> 各存一份，会漂移；由 dita-tools 的
     一致性检查兜住（navtitle 与被引 map 标题不符即报警），不靠人记得同步。

     迁移路径：将来某个分支写了真实的落地 topic（如「Web 技术栈」概览），就把该
     分支的 topichead 换成指向那个 topic 的 topicref——分组节点从空壳变成真实页面，
     标题副本随之消失。逐分支迁移，互不影响。topichead 是当前形态，不是终态。 -->
<map xml:lang="zh-CN">
  <title>知识体系</title>

  <!-- 词表：受控值来源，resource-only 不进导航 -->
  <mapref href="../vocab/subjectScheme.ditamap" format="ditamap" processing-role="resource-only"/>

  <!-- 九个领域。navtitle 必须与被引 map 的 <title> 逐字一致。 -->
  <topichead>
    <topicmeta><navtitle>编程语言</navtitle></topicmeta>
    <mapref href="domains/lang.ditamap"/>
  </topichead>
  <topichead>
    <topicmeta><navtitle>Web 技术栈</navtitle></topicmeta>
    <mapref href="domains/web.ditamap"/>
  </topichead>
  <topichead>
    <topicmeta><navtitle>数据存储</navtitle></topicmeta>
    <mapref href="domains/data.ditamap"/>
  </topichead>
  <topichead>
    <topicmeta><navtitle>网络协议</navtitle></topicmeta>
    <mapref href="domains/network.ditamap"/>
  </topichead>
  <topichead>
    <topicmeta><navtitle>安全</navtitle></topicmeta>
    <mapref href="domains/security.ditamap"/>
  </topichead>
  <topichead>
    <topicmeta><navtitle>AI</navtitle></topicmeta>
    <mapref href="domains/ai.ditamap"/>
  </topichead>
  <topichead>
    <topicmeta><navtitle>工程化</navtitle></topicmeta>
    <mapref href="domains/engineering.ditamap"/>
  </topichead>
  <topichead>
    <topicmeta><navtitle>基础</navtitle></topicmeta>
    <mapref href="domains/foundations.ditamap"/>
  </topichead>
  <topichead>
    <topicmeta><navtitle>知识工程</navtitle></topicmeta>
    <mapref href="domains/content-engineering.ditamap"/>
  </topichead>

  <!-- 术语库：纯组织节点，没有对应的内容页，topichead 就是它的终态 -->
  <topichead>
    <topicmeta><navtitle>术语库</navtitle></topicmeta>
    <mapref href="glossary.ditamap"/>
  </topichead>
</map>
