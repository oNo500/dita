<?xml version="1.0" encoding="UTF-8"?>
<!-- R14 边界样例：来源节写成无来源声明，不分段，也不含任何标记。 -->
<concept id="source-no-external" outputclass="best-practice" maturity="curated" volatility="stable">
  <title>无外部来源的样例</title>
  <shortdesc>各节齐全，来源节以固定字面声明本篇没有外部来源。</shortdesc>
  <conbody>
    <section><title>场景</title><p>说明。</p></section>
    <section><title>做法：三条</title><p>说明。</p></section>
    <section><title>边界</title><p>说明。</p></section>
    <section><title>来源</title>
      <p>本篇无外部来源，属本库方法论。</p>
    </section>
  </conbody>
</concept>
